# Core integrations. All are optional for offline deterministic RCA. Never
# commit the populated .env file.
GITHUB_ACCESS_TOKEN=your_github_token
TAVILY_API_KEY=your_tavily_api_key_here

# AI enrichment is opt-in: none, auto, bedrock, or ollama.
LLM_PROVIDER=none

# Bedrock provider (may also use an AWS profile/workload identity).
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Ollama provider (local and non-billable; start the Ollama server separately).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# Dashboard/deployment safety. Set APP_PASSWORD for any public deployment and
# restrict the server-side GitHub token to the repositories listed here.
APP_PASSWORD=choose_a_long_random_password
ALLOWED_REPOSITORIES=owner/repository
DEFAULT_REPOSITORY=owner/repository
ANALYSIS_COOLDOWN_SECONDS=5
# MAX_LOG_UPLOAD_BYTES=2097152

# Optional persistent mount locations (defaults to ./data, ./models, ./output).
# DATA_DIR=/app/data
# MODELS_DIR=/app/models
# OUTPUT_DIR=/app/output
